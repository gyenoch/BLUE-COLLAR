# ================================================================
# BLUE-COLLAR AGENT — MASTER ENVIRONMENT VARIABLES (EXAMPLE)
# ================================================================
# Copy this file to .env and fill in every value.
# Read docs/DEPLOYMENT-GUIDE.md for step-by-step instructions
# on where to get each key.
#
# REQUIRED = app will crash without this
# OPTIONAL = feature disabled if missing
# ================================================================


# ================================================================
# SECTION 1 — SERVER CONFIG
# ================================================================

# [REQUIRED] Runtime environment
NODE_ENV=development

# [REQUIRED] Express API port
PORT=3001

# [REQUIRED] Public base URL of the API
# Local: http://localhost:3001 | Production: https://your-project.railway.app
API_BASE_URL=http://localhost:3001

# [REQUIRED] WebSocket URL for Twilio audio streaming
# Local: wss://xxxx.ngrok.io | Production: wss://your-project.railway.app
WS_BASE_URL=wss://xxxx.ngrok.io


# ================================================================
# SECTION 2 — DATABASE (Supabase PostgreSQL)
# ================================================================
# https://supabase.com → Project → Settings → Database & API

# [REQUIRED] PostgreSQL connection string (use pooler URL)
DATABASE_URL=

# [REQUIRED] Supabase project URL
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# [REQUIRED] Anonymous/public key — safe to expose in frontend
SUPABASE_ANON_KEY=

# [REQUIRED] Service role key — keep secret, backend only
SUPABASE_SERVICE_KEY=

# ================================================================
# SECTION 3 — CACHE (Upstash Redis)
# ================================================================
# https://console.upstash.com → Database → REST API tab

# [REQUIRED] Upstash REST URL (must start with https://)
UPSTASH_REDIS_URL=https://[DATABASE-NAME].upstash.io

# [REQUIRED] Upstash REST auth token
UPSTASH_REDIS_TOKEN=


# ================================================================
# SECTION 4 — AUTHENTICATION (Clerk)
# ================================================================
# https://dashboard.clerk.com → Configure → API Keys

# [REQUIRED] Public key — used by API, dashboard, and mobile
CLERK_PUBLISHABLE_KEY=

# [REQUIRED] Secret key — backend API only
CLERK_SECRET_KEY=

# [REQUIRED] Webhook signing secret — Configure → Webhooks → your endpoint
CLERK_WEBHOOK_SECRET=

# Clerk redirect paths (Next.js dashboard)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# [REQUIRED for dashboard] Same value as CLERK_PUBLISHABLE_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# [REQUIRED for mobile] Same value as CLERK_PUBLISHABLE_KEY
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=


# ================================================================
# SECTION 5 — VOICE AI: TWILIO (Phone Infrastructure)
# ================================================================
# https://console.twilio.com → Account Info panel

# [REQUIRED] Account SID — starts with AC
TWILIO_ACCOUNT_SID=

# [REQUIRED] Auth token — click eye icon to reveal
TWILIO_AUTH_TOKEN=

# [REQUIRED] Your Twilio phone number in E.164 format
TWILIO_PHONE_NUMBER=

# [REQUIRED] URL Twilio calls when a call comes in
# Set in: Console → Phone Numbers → your number → Voice webhook
TWILIO_WEBHOOK_URL=https://xxxx.ngrok.io/webhooks/twilio/voice


# ================================================================
# SECTION 6 — VOICE AI: ANTHROPIC (Claude — AI Brain)
# ================================================================
# https://console.anthropic.com → API Keys → Create Key

# [REQUIRED] Secret API key — starts with sk-ant-
ANTHROPIC_API_KEY=


# ================================================================
# SECTION 7 — VOICE AI: DEEPGRAM (Speech-to-Text)
# ================================================================
# https://console.deepgram.com → API Keys → Create a New API Key
# Note: $200 free credit on sign-up (no credit card needed)

# [REQUIRED] Deepgram API key
DEEPGRAM_API_KEY=


# ================================================================
# SECTION 8 — VOICE AI: ELEVENLABS (Text-to-Speech)
# ================================================================
# https://elevenlabs.io → Profile (top right) → API Key

# [REQUIRED] ElevenLabs API key
ELEVENLABS_API_KEY=
# [REQUIRED] Voice ID for English calls
# Default Rachel (professional American): 21m00Tcm4TlvDq8ikWAM
# Browse all voices: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=

# [REQUIRED for bilingual] Voice ID for Spanish calls
# Browse Spanish voices at voice library, filter by Language: Spanish
ELEVENLABS_VOICE_ID_ES=

# ================================================================
# SECTION 9 — GOOGLE CALENDAR INTEGRATION
# ================================================================
# https://console.cloud.google.com → APIs & Services → Credentials
# Enable "Google Calendar API" → Create OAuth 2.0 Client ID

# [OPTIONAL] OAuth 2.0 client ID
GOOGLE_CLIENT_ID=

# [OPTIONAL] OAuth 2.0 client secret
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Must match your Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3001/integrations/google/callback


# ================================================================
# SECTION 10 — JOBBER CRM INTEGRATION
# ================================================================
# Apply: https://developer.getjobber.com (approval takes 2-4 weeks)

# [OPTIONAL] Jobber OAuth client ID
JOBBER_CLIENT_ID=

# [OPTIONAL] Jobber OAuth client secret
JOBBER_CLIENT_SECRET=

# [OPTIONAL] OAuth redirect URI
JOBBER_REDIRECT_URI=http://localhost:3001/integrations/jobber/callback


# ================================================================
# SECTION 11 — SERVICETITAN CRM INTEGRATION
# ================================================================
# Apply: https://developer.servicetitan.io (for larger shops only, skip for MVP)

# [OPTIONAL]
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
SERVICETITAN_TENANT_ID=


# ================================================================
# SECTION 12 — PAYMENTS (Stripe)
# ================================================================
# https://dashboard.stripe.com → Developers → API Keys
# Use sk_test_ / pk_test_ keys until you go live

# [OPTIONAL] Secret key — backend only
STRIPE_SECRET_KEY=

# [OPTIONAL] Publishable key — safe for frontend
STRIPE_PUBLISHABLE_KEY=

# [OPTIONAL] Same as STRIPE_PUBLISHABLE_KEY, prefixed for Next.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# [OPTIONAL] Webhook signing secret — Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=

# Price IDs — create at: Products → Add Product → set monthly price
# [OPTIONAL] Starter plan price ID ($299/month)
STRIPE_PRICE_ID_STARTER=

# [OPTIONAL] Professional plan price ID ($499/month)
STRIPE_PRICE_ID_PROFESSIONAL=

# [OPTIONAL] Team plan price ID ($799/month)
STRIPE_PRICE_ID_TEAM=


# ================================================================
# SECTION 13 — EMAIL (Resend)
# ================================================================
# https://resend.com → API Keys → Create API Key

# [OPTIONAL] Resend API key
RESEND_API_KEY=

# [OPTIONAL] From address (must be from a verified domain in production)
EMAIL_FROM=noreply@bluecollaragent.com

# [OPTIONAL] Support email shown to customers
SUPPORT_EMAIL=support@bluecollaragent.com


# ================================================================
# SECTION 14 — JOB QUEUE (Quirrel)
# ================================================================
# Local dev: run "npx quirrel" in terminal (no token needed)
# Production: https://quirrel.dev → sign up → get token

# [REQUIRED] Quirrel server URL
# Local: http://localhost:9181 | Cloud: https://api.quirrel.dev
QUIRREL_API_URL=http://localhost:9181

# [OPTIONAL] Only needed for Quirrel Cloud (not local dev)
QUIRREL_TOKEN=


# ================================================================
# SECTION 15 — ERROR MONITORING (Sentry)
# ================================================================
# https://sentry.io → Settings → Projects → Client Keys (DSN)

# [OPTIONAL] API backend DSN
SENTRY_DSN=

# [OPTIONAL] Dashboard frontend DSN (same project or different)
NEXT_PUBLIC_SENTRY_DSN=

# [OPTIONAL] Organization slug from Sentry URL
SENTRY_ORG=your-org-slug

# [OPTIONAL] Sentry project name
SENTRY_PROJECT=blue-collar-agent

# [OPTIONAL] Auth token for source map uploads in CI/CD
SENTRY_AUTH_TOKEN=


# ================================================================
# SECTION 16 — LOGGING (Better Stack)
# ================================================================
# https://betterstack.com → Logs → Sources → Connect source

# [OPTIONAL] Source token for log ingestion
BETTERSTACK_SOURCE_TOKEN=


# ================================================================
# SECTION 17 — PRODUCT ANALYTICS (PostHog)
# ================================================================
# https://app.posthog.com → Project Settings → API Keys

# [OPTIONAL] Project API key — safe to expose in frontend
NEXT_PUBLIC_POSTHOG_KEY=

# [OPTIONAL] PostHog ingestion host
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ================================================================
# SECTION 18 — FRONTEND URLS
# ================================================================

# [REQUIRED for dashboard] API URL that Next.js calls
# Local: http://localhost:3001 | Production: https://your-project.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# [REQUIRED for mobile] API URL that Expo app calls
# Local: use your LAN IP (run ipconfig → find IPv4 address)
# Example: http://192.168.1.105:3001
# Production: https://your-project.railway.app
EXPO_PUBLIC_API_URL=http://192.168.1.X:3001


# ================================================================
# SECTION 19 — FEATURE FLAGS
# ================================================================

# [OPTIONAL] Auto-send Google review requests after completed jobs
ENABLE_REVIEW_AUTOMATION=true

# [OPTIONAL] Follow up on unanswered quotes (Day 2, 7, 14 sequence)
ENABLE_QUOTE_FOLLOWUP=true

# [OPTIONAL] AI calls customer the day before to confirm appointment
ENABLE_VOICE_REMINDERS=true

# [OPTIONAL] Seasonal campaign emails — disable until 30+ customers
ENABLE_SEASONAL_CAMPAIGNS=false

# [OPTIONAL] Send events to PostHog for product analytics
ENABLE_ANALYTICS_TRACKING=true


# ================================================================
# SECTION 20 — RATE LIMITING
# ================================================================

# [OPTIONAL] Time window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# [OPTIONAL] Max requests per IP per window
RATE_LIMIT_MAX_REQUESTS=100
