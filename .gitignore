.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# ============================================
# PROJECT SPECIFIC
# ============================================
# Call recordings
apps/api/recordings/
apps/api/public/recordings/

# Transcripts
apps/api/transcripts/

# Customer data backups
backups/
*.backup

# Local development overrides
local/
.local/

# Documentation builds
docs/_build/
docs/.doctrees/

# Benchmark results
benchmark-results/

# ============================================
# KEEP THESE FILES (negation)
# ============================================
# Keep example env files
!.env.example
!.env.local.example
!apps/*/.env.example

# Keep Docker files
!Dockerfile
!docker-compose.yml
!.dockerignore

# Keep GitHub workflows
!.github/

# Keep README files
!README.md
!**/README.md

# Keep LICENSE
!LICENSE

# Keep VS Code recommended extensions
!.vscode/extensions.json

# ============================================
# MONOREPO SPECIFIC
# ============================================
# Ignore all node_modules in subdirectories
**/node_modules/

# Ignore all dist directories
**/dist/

# Ignore all build directories
**/build/

# Ignore all .next directories
**/.next/

# New Files
SaaS-logic/
.claude/

# ============================================
# END OF .GITIGNORE
# ============================================
