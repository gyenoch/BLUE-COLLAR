# ============================================================
# BLUE-COLLAR AGENT — Mobile App Environment Variables
# Copy this file: cp .env.example .env
# Note: All Expo public vars must start with EXPO_PUBLIC_
# ============================================================

# ─── API CONNECTION ──────────────────────────────────────────
# Local dev: use your machine's local IP (not localhost — device can't reach it)
# Find your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.1.X:3001
# Production: https://your-project.railway.app
# EXPO_PUBLIC_API_URL=https://your-project.railway.app

# ─── AUTH (Clerk) ────────────────────────────────────────────
# REQUIRED — Get from: https://dashboard.clerk.com → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
