# ============================================================
# BLUE-COLLAR AGENT — API Environment Variables
# Copy this file: cp .env.example .env
# Then fill in EVERY value marked as REQUIRED
# ============================================================

# ─── SERVER ─────────────────────────────────────────────────
# REQUIRED
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
# Production: https://your-project.railway.app

# WebSocket base URL (used to build Twilio media stream URL)
# Local dev: use ngrok HTTPS URL e.g. wss://xxxx.ngrok.io
# Production: wss://your-project.railway.app
WS_BASE_URL=wss://xxxx.ngrok.io

# ─── DATABASE (Supabase) ─────────────────────────────────────
# REQUIRED — Get from: https://supabase.com → Project → Settings → Database
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Get from: Project → Settings → API → service_role key (keep this secret!)
SUPABASE_SERVICE_KEY=

# ─── CACHE (Upstash Redis) ───────────────────────────────────
# REQUIRED — Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── AUTH (Clerk) ────────────────────────────────────────────
# REQUIRED — Get from: https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Get from: Clerk → Webhooks → Add Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=

# ─── VOICE AI: TWILIO ────────────────────────────────────────
# REQUIRED — Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your purchased Twilio phone number in E.164 format
TWILIO_PHONE_NUMBER=

# Set in Twilio Console → Phone Numbers → Manage → Active Numbers → Webhook
TWILIO_WEBHOOK_URL=

# ─── VOICE AI: ANTHROPIC (Claude) ───────────────────────────
# REQUIRED — Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── VOICE AI: DEEPGRAM (Speech-to-Text) ─────────────────────
# REQUIRED — Get from: https://console.deepgram.com → API Keys → Create New Key
DEEPGRAM_API_KEY=
# ─── VOICE AI: ELEVENLABS (Text-to-Speech) ───────────────────
# REQUIRED — Get from: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
# Voice ID — Default is "Rachel" (clear American English)
# Find IDs at: https://elevenlabs.io/voice-library
# Rachel = 21m00Tcm4TlvDq8ikWAM | Sarah = EXAVITQu4vr4xnSDxMaL | Adam = pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID=
# Spanish voice ID (for bilingual support)
ELEVENLABS_VOICE_ID_ES=

# ─── GOOGLE CALENDAR ─────────────────────────────────────────
# OPTIONAL (required for booking sync)
# Get from: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/integrations/google/callback
# Production: https://your-project.railway.app/integrations/google/callback

# ─── JOBBER CRM ──────────────────────────────────────────────
# OPTIONAL (required for CRM sync) — Apply at: https://developer.getjobber.com
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=http://localhost:3001/integrations/jobber/callback

# ─── SERVICETITAN (optional) ────────────────────────────────
# For larger shops — Apply at: https://developer.servicetitan.io
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
SERVICETITAN_TENANT_ID=

# ─── PAYMENTS (Stripe) ───────────────────────────────────────
# OPTIONAL (required for billing) — Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get from: Stripe → Developers → Webhooks → Add Endpoint → Signing Secret
STRIPE_WEBHOOK_SECRET=
# Create products at: Stripe → Products → Add Product
# Then copy the Price ID for each plan
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PROFESSIONAL=
STRIPE_PRICE_ID_TEAM=

# ─── EMAIL (Resend) ──────────────────────────────────────────
# OPTIONAL (required for email notifications) — Get from: https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM=noreply@bluecollaragent.com
SUPPORT_EMAIL=support@bluecollaragent.com

# ─── JOB QUEUE (Quirrel) ─────────────────────────────────────
# OPTIONAL — Self-host or use Quirrel Cloud: https://quirrel.dev
# For local dev, run: npx quirrel (no token needed)
QUIRREL_API_URL=http://localhost:9181
QUIRREL_TOKEN=
# Production (Quirrel Cloud):
# QUIRREL_API_URL=https://api.quirrel.dev
# QUIRREL_TOKEN=qrl_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── MONITORING (Sentry) ─────────────────────────────────────
# OPTIONAL — Get from: https://sentry.io → Projects → Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=blue-collar-api
SENTRY_AUTH_TOKEN=

# ─── MONITORING (Better Stack) ───────────────────────────────
# OPTIONAL — Get from: https://betterstack.com → Logs → Sources → Connect source
BETTERSTACK_SOURCE_TOKEN=

# ─── FEATURE FLAGS ───────────────────────────────────────────
ENABLE_REVIEW_AUTOMATION=true
ENABLE_QUOTE_FOLLOWUP=true
ENABLE_VOICE_REMINDERS=true
ENABLE_SEASONAL_CAMPAIGNS=false
ENABLE_ANALYTICS_TRACKING=true

# ─── RATE LIMITING ───────────────────────────────────────────
# 15 minutes window, 100 requests max
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
